{%- liquid
  capture msa_handle_raw
    render 'msa-get-handle'
  endcapture
  assign msa_handle = msa_handle_raw | strip | downcase
  assign path_down = request.path | downcase

  # Never treat Shopify's 404 path segment as a page handle.
  if msa_handle == '404' or msa_handle == 'not-found'
    assign msa_handle = ''
  endif

  # Hard-map known Admin page handles / URLs (must run before other logic).
  if page.handle == 'our-beliefs' or page.handle == 'beliefs' or path_down contains 'our-beliefs' or path_down contains '/pages/beliefs' or msa_handle == 'our-beliefs' or msa_handle == 'beliefs'
    assign msa_handle = 'beliefs'
  elsif page.handle == 'faq' or page.handle == 'faqs' or path_down contains '/pages/faqs' or path_down contains '/pages/faq' or msa_handle == 'faq' or msa_handle == 'faqs'
    assign msa_handle = 'faqs'
  elsif path_down contains '/pages/about' or msa_handle == 'about'
    assign msa_handle = 'about'
  elsif path_down contains '/pages/careers' or msa_handle == 'careers'
    assign msa_handle = 'careers'
  elsif path_down contains '/pages/commitment' or msa_handle == 'commitment'
    assign msa_handle = 'commitment'
  elsif path_down contains '/pages/ethics' or msa_handle == 'ethics'
    assign msa_handle = 'ethics'
  elsif path_down contains 'organic-cotton' or msa_handle == 'organic-cotton'
    assign msa_handle = 'organic-cotton'
  elsif path_down contains 'recycled-polyester' or msa_handle == 'recycled-polyester'
    assign msa_handle = 'recycled-polyester'
  elsif path_down contains 'responsible-sourcing' or msa_handle == 'responsible-sourcing'
    assign msa_handle = 'responsible-sourcing'
  elsif path_down contains 'less-waste' or msa_handle == 'less-waste'
    assign msa_handle = 'less-waste'
  elsif path_down contains 'size-charts' or msa_handle == 'size-charts'
    assign msa_handle = 'size-charts'
  elsif path_down contains '/pages/shipping' or msa_handle == 'shipping'
    assign msa_handle = 'shipping'
  elsif path_down contains '/pages/returns' or msa_handle == 'returns'
    assign msa_handle = 'returns'
  elsif path_down contains 'accessibility' or msa_handle == 'accessibility-statement'
    assign msa_handle = 'accessibility-statement'
  elsif path_down contains 'privacy-policy' or msa_handle == 'privacy-policy'
    assign msa_handle = 'privacy-policy'
  elsif path_down contains 'terms-and-conditions' or msa_handle == 'terms-and-conditions'
    assign msa_handle = 'terms-and-conditions'
  elsif path_down contains 'do-not-sell' or msa_handle == 'do-not-sell-or-share'
    assign msa_handle = 'do-not-sell-or-share'
  elsif path_down contains 'cookie-policy' or path_down contains 'cookie-settings' or msa_handle == 'cookie-policy' or msa_handle == 'cookie-settings'
    assign msa_handle = 'cookie-policy'
  elsif path_down contains 'affiliate' or msa_handle == 'affiliate-program'
    assign msa_handle = 'affiliate-program'
  elsif path_down contains '/pages/vendors' or msa_handle == 'vendors'
    assign msa_handle = 'vendors'
  elsif path_down contains '/pages/services' or msa_handle == 'services'
    assign msa_handle = 'services'
  endif

  # On 404, page.handle is blank — detect known pages from the requested path,
  # and from content_for_header pageurl when Shopify rewrites the path to /404.
  if msa_handle == blank or template.name == '404'
    assign detect_source = path_down

    if detect_source == '/404' or detect_source == '404' or detect_source contains '/404'
      capture content_for_query_string
        echo content_for_header
      endcapture
      assign page_url = content_for_query_string | split: '"pageurl":"' | last | split: '"' | first | replace: '\/', '/' | downcase
      if page_url contains '/pages/'
        assign detect_source = page_url
      endif
      if detect_source == '/404' or detect_source == '404' or detect_source contains '/404'
        if content_for_query_string contains 'our-beliefs'
          assign detect_source = '/pages/our-beliefs'
        elsif content_for_query_string contains '/pages/beliefs'
          assign detect_source = '/pages/beliefs'
        elsif content_for_query_string contains '/pages/faqs'
          assign detect_source = '/pages/faqs'
        elsif content_for_query_string contains '/pages/faq'
          assign detect_source = '/pages/faq'
        endif
      endif
    endif

    if detect_source contains 'contact-us' or detect_source contains '/pages/contact'
      assign msa_handle = 'contact-us'
    elsif detect_source contains 'our-beliefs' or detect_source contains '/pages/beliefs' or detect_source contains '/beliefs'
      assign msa_handle = 'beliefs'
    elsif detect_source contains '/pages/about' or detect_source contains '/about'
      assign msa_handle = 'about'
    elsif detect_source contains '/pages/services' or detect_source contains '/services'
      assign msa_handle = 'services'
    elsif detect_source contains '/pages/vendors' or detect_source contains '/vendors'
      assign msa_handle = 'vendors'
    elsif detect_source contains '/pages/careers' or detect_source contains '/careers'
      assign msa_handle = 'careers'
    elsif detect_source contains '/pages/commitment' or detect_source contains '/commitment'
      assign msa_handle = 'commitment'
    elsif detect_source contains '/pages/ethics' or detect_source contains '/ethics'
      assign msa_handle = 'ethics'
    elsif detect_source contains 'organic-cotton'
      assign msa_handle = 'organic-cotton'
    elsif detect_source contains 'recycled-polyester'
      assign msa_handle = 'recycled-polyester'
    elsif detect_source contains 'responsible-sourcing'
      assign msa_handle = 'responsible-sourcing'
    elsif detect_source contains 'less-waste'
      assign msa_handle = 'less-waste'
    elsif detect_source contains '/pages/rewards' or detect_source contains '/rewards'
      assign msa_handle = 'rewards'
    elsif detect_source contains '/pages/faqs' or detect_source contains '/faqs'
      assign msa_handle = 'faqs'
    elsif detect_source contains '/pages/faq' or detect_source contains '/faq'
      assign msa_handle = 'faqs'
    elsif detect_source contains 'do-not-sell' or detect_source contains 'do_not_sell'
      assign msa_handle = 'do-not-sell-or-share'
    elsif detect_source contains 'cookie-policy' or detect_source contains 'cookie-settings'
      assign msa_handle = 'cookie-policy'
    elsif detect_source contains 'size-charts' or detect_source contains 'size-chart'
      assign msa_handle = 'size-charts'
    elsif detect_source contains '/pages/shipping'
      assign msa_handle = 'shipping'
    elsif detect_source contains '/pages/returns'
      assign msa_handle = 'returns'
    elsif detect_source contains 'accessibility'
      assign msa_handle = 'accessibility-statement'
    elsif detect_source contains 'privacy'
      assign msa_handle = 'privacy-policy'
    elsif detect_source contains 'terms'
      assign msa_handle = 'terms-and-conditions'
    elsif detect_source contains 'affiliate'
      assign msa_handle = 'affiliate-program'
    endif
  endif
-%}

{%- liquid
  assign msa_title = ''
  assign msa_description = ''
  assign msa_known = false

  case msa_handle
    when 'about'
      assign msa_known = true
      assign msa_title = 'About us'
    when 'services'
      assign msa_known = true
      assign msa_title = 'MSA sourcing services'
    when 'vendors'
      assign msa_known = true
      assign msa_title = 'Vendors'
    when 'contact', 'contact-us'
      assign msa_known = true
      assign msa_title = 'Contact us'
      assign msa_description = '<p>Whether you are looking to partner with us, have questions about our services, or simply want to learn more, fill out the form below. Our team will contact you as soon as possible.</p>'
    when 'beliefs', 'our-beliefs'
      assign msa_known = true
      assign msa_title = 'Our beliefs'
      assign msa_handle = 'beliefs'
    when 'careers'
      assign msa_known = true
      assign msa_title = 'Careers'
    when 'rewards'
      assign msa_known = true
      assign msa_title = 'Rewards club'
    when 'faqs'
      assign msa_known = true
      assign msa_title = 'FAQ'
    when 'size-charts'
      assign msa_known = true
      assign msa_title = 'Size charts'
    when 'shipping'
      assign msa_known = true
      assign msa_title = 'Shipping'
    when 'returns'
      assign msa_known = true
      assign msa_title = 'Returns'
    when 'accessibility-statement'
      assign msa_known = true
      assign msa_title = 'Accessibility'
    when 'privacy-policy'
      assign msa_known = true
      assign msa_title = 'Privacy policy'
    when 'terms-and-conditions'
      assign msa_known = true
      assign msa_title = 'Terms & conditions'
    when 'affiliate-program'
      assign msa_known = true
      assign msa_title = 'Affiliate program'
    when 'lookbook'
      assign msa_known = true
      assign msa_title = 'Lookbook'
    when 'commitment'
      assign msa_known = true
      assign msa_title = 'Commitment'
    when 'ethics'
      assign msa_known = true
      assign msa_title = 'Ethics'
    when 'organic-cotton'
      assign msa_known = true
      assign msa_title = 'Organic cotton'
    when 'recycled-polyester'
      assign msa_known = true
      assign msa_title = 'Recycled polyester'
    when 'responsible-sourcing'
      assign msa_known = true
      assign msa_title = 'Responsible sourcing'
    when 'less-waste'
      assign msa_known = true
      assign msa_title = 'Less waste'
    when 'do-not-sell-or-share'
      assign msa_known = true
      assign msa_title = 'Do not sell or share'
    when 'cookie-policy', 'cookie-settings'
      assign msa_known = true
      assign msa_title = 'Cookie settings'
  endcase
-%}

{%- if msa_known -%}
  {%- assign msa_fullbleed = false -%}
  {%- if msa_handle == 'careers' or msa_handle == 'about' or msa_handle == 'beliefs' or msa_handle == 'commitment' or msa_handle == 'ethics' or msa_handle == 'organic-cotton' or msa_handle == 'recycled-polyester' or msa_handle == 'responsible-sourcing' or msa_handle == 'less-waste' or msa_handle == 'faqs' or msa_handle == 'size-charts' or msa_handle == 'shipping' or msa_handle == 'returns' or msa_handle == 'accessibility-statement' or msa_handle == 'privacy-policy' or msa_handle == 'terms-and-conditions' or msa_handle == 'affiliate-program' or msa_handle == 'vendors' or msa_handle == 'services' or msa_handle == 'do-not-sell-or-share' or msa_handle == 'cookie-policy' or msa_handle == 'cookie-settings' -%}
    {%- assign msa_fullbleed = true -%}
  {%- endif -%}
  {%- unless msa_fullbleed -%}
    {% render 'msa-page-heading', title: msa_title, description: msa_description %}
  {%- endunless -%}

  {%- case msa_handle -%}
    {%- when 'about' -%}
      {% render 'msa-content-about' %}
    {%- when 'services' -%}
      {% render 'msa-content-help', page_key: 'services' %}
    {%- when 'vendors' -%}
      {% render 'msa-content-help', page_key: 'vendors' %}
    {%- when 'contact', 'contact-us' -%}
      {% render 'msa-content-contact' %}
    {%- when 'beliefs' -%}
      {% render 'msa-content-beliefs' %}
    {%- when 'careers' -%}
      {% render 'msa-content-careers' %}
    {%- when 'commitment' -%}
      {% render 'msa-content-brand-topic',
        eyebrow: 'Our commitment',
        title: 'Commitment',
        intro: 'At Moon Apparel, we believe businesses should create a positive impact beyond fashion. Supporting communities and investing in brighter futures is an important part of who we are.',
        hero_image: 'moon-page-commitment.jpg',
        hero_alt: 'Education and community impact supported by Moon Apparel',
        body_html: '<p>Supporting communities and investing in brighter futures is an important part of who we are. We partner with organisations that create lasting opportunity through education.</p>',
        split_image: 'moon-page-team.jpg',
        split_alt: 'Moon Apparel community partnership',
        split_title: 'Charitable partner — SAVE DC',
        split_html: '<p>We are proud to support <strong>SAVE DC</strong>, an organisation dedicated to transforming lives through education. Their mission focuses on expanding educational opportunities, empowering individuals, and helping communities build a stronger future.</p><p>By partnering with SAVE DC, we are honoured to contribute to initiatives that create meaningful and lasting change through the power of education.</p>',
        highlight_eyebrow: 'Impact beyond fashion',
        highlight_title: 'Why this matters',
        highlight_html: '<p>True business success is measured not only by products sold, but by the positive difference we help create for people and communities.</p>',
        cta_title: 'Learn more about our values',
        cta_text: 'Explore ethics, responsible sourcing, and the materials we choose.',
        cta_label: 'Our beliefs',
        cta_link: '/pages/beliefs'
      %}
    {%- when 'ethics' -%}
      {% render 'msa-content-brand-topic',
        eyebrow: 'Standards',
        title: 'Ethics',
        intro: 'Respect, fairness, and integrity guide every decision we make at Moon Apparel.',
        hero_image: 'moon-page-ethics.jpg',
        hero_alt: 'Ethical manufacturing and teamwork at Moon Apparel',
        body_html: '<p>We support ethical manufacturing practices and believe everyone involved in creating our products deserves safe working conditions, fair treatment, and respect.</p><p>We are committed to building long-term relationships with partners who share these values — from product development to delivery.</p>',
        split_image: 'moon-page-manufacturing.jpg',
        split_alt: 'Quality controlled garment production',
        split_title: 'How we work',
        split_html: '<p>From product development to delivery, we work to ensure dignity and respect for everyone involved in bringing Moon Apparel to life. Our teams oversee quality, accountability, and transparent partnerships.</p>',
        highlight_eyebrow: 'Our promise',
        highlight_title: 'Fairness at every stage',
        highlight_html: '<p>Ethical standards are not a campaign — they are part of how Moon Apparel operates every day with manufacturing partners and suppliers.</p>'
      %}
    {%- when 'organic-cotton' -%}
      {% render 'msa-content-brand-topic',
        eyebrow: 'Materials',
        title: 'Organic cotton',
        intro: 'Where possible, we incorporate organic cotton into Moon Apparel collections for naturally soft, comfortable fabrics.',
        hero_image: 'moon-page-cotton.jpg',
        hero_alt: 'Organic cotton fabric and apparel materials',
        body_html: '<p>Organic cotton is grown using farming practices that reduce the use of synthetic chemicals while supporting healthier ecosystems.</p><p>Choosing organic cotton where it makes sense helps us deliver quality clothing with a more responsible material footprint.</p>',
        split_image: 'moon-page-design.jpg',
        split_alt: 'Soft cotton apparel design',
        split_title: 'Better for wear and for farming',
        split_html: '<p>Customers feel the difference in comfort. Farms benefit from practices that support healthier soil and reduced chemical reliance. Look for organic cotton details on product pages as we expand preferred fibres.</p>',
        highlight_eyebrow: 'Related',
        highlight_title: 'Part of responsible materials',
        highlight_html: '<p>Organic cotton sits alongside recycled polyester, responsible sourcing, and our less-waste approach. Explore the full set of Moon Apparel material and sourcing pages.</p>'
      %}
    {%- when 'recycled-polyester' -%}
      {% render 'msa-content-brand-topic',
        eyebrow: 'Materials',
        title: 'Recycled polyester',
        intro: 'We increasingly use recycled polyester to help reduce waste and conserve valuable natural resources.',
        hero_image: 'moon-page-recycled.jpg',
        hero_alt: 'Recycled materials used in apparel',
        body_html: '<p>Giving existing materials a second life contributes to a more sustainable fashion industry and can reduce reliance on virgin plastics in apparel production.</p><p>We continue expanding preferred fibres across key Moon Apparel styles.</p>',
        split_image: 'moon-page-waste.jpg',
        split_alt: 'Reducing waste through better materials',
        split_title: 'A second life for materials',
        split_html: '<p>Recycled polyester helps turn existing resources into durable clothing. Combined with thoughtful design, it supports our goal of quality garments with a lighter impact.</p>',
        highlight_eyebrow: 'Keep exploring',
        highlight_title: 'Connected to less waste',
        highlight_html: '<p>Material choices and waste reduction work together. See also our pages on organic cotton, responsible sourcing, and less waste.</p>'
      %}
    {%- when 'responsible-sourcing' -%}
      {% render 'msa-content-brand-topic',
        eyebrow: 'Supply chain',
        title: 'Responsible sourcing',
        intro: 'Responsible sourcing is central to Moon Apparel. We work with suppliers and manufacturing partners who share our commitment to ethical business practices.',
        hero_image: 'moon-page-sourcing.jpg',
        hero_alt: 'Responsible sourcing and partner collaboration',
        body_html: '<p>We prioritise quality workmanship, safe working conditions, and responsible production standards across our supply relationships.</p><p>Long-term partnerships help us maintain consistency while improving standards over time.</p>',
        split_image: 'moon-page-ethics.jpg',
        split_alt: 'Working with trusted manufacturing partners',
        split_title: 'Partners who share our standards',
        split_html: '<p>From cotton and recycled fibres to finished garments, our teams work closely with vendors to improve quality, accountability, and reliability for every Moon Apparel order.</p>',
        highlight_eyebrow: 'Connected values',
        highlight_title: 'Sourcing with integrity',
        highlight_html: '<p>Responsible sourcing links directly to our ethics, materials choices, and commitment to communities through SAVE DC.</p>'
      %}
    {%- when 'less-waste' -%}
      {% render 'msa-content-brand-topic',
        eyebrow: 'Planet',
        title: 'Less waste',
        intro: 'We continually review production and packaging processes to reduce unnecessary waste across the Moon Apparel business.',
        hero_image: 'moon-page-waste.jpg',
        hero_alt: 'Reducing waste in apparel production',
        body_html: '<p>From improving operational efficiency to using more sustainable materials where possible, we are committed to meaningful improvements that benefit both our customers and the environment.</p>',
        split_image: 'moon-page-recycled.jpg',
        split_alt: 'Smarter material utilisation',
        split_title: 'Designing for longevity',
        split_html: '<p>Thoughtful product design, better material utilisation, and longer-lasting garments help reduce waste season after season. Small changes in cut, fabric choice, and production planning add up.</p>',
        highlight_eyebrow: 'Keep learning',
        highlight_title: 'Materials and methods',
        highlight_html: '<p>Explore organic cotton, recycled polyester, and responsible sourcing to see how Moon Apparel approaches waste reduction end to end.</p>'
      %}
    {%- when 'rewards' -%}
      {% render 'msa-content-simple',
        title: 'Moon SA rewards',
        body: '<p>Earn points on every purchase and unlock exclusive perks as a Moon Apparel rewards member.</p><p><strong>How it works:</strong> Create an account, shop your favourite styles, and earn points for every pound spent.</p><p><a href="/account/register">Join now</a> or <a href="/account/login">log in</a> to your existing account.</p>'
      %}
    {%- when 'faqs' -%}
      {% render 'msa-content-faqs' %}
    {%- when 'size-charts' -%}
      {% render 'msa-content-help', page_key: 'size-charts' %}
    {%- when 'shipping' -%}
      {% render 'msa-content-help', page_key: 'shipping' %}
    {%- when 'returns' -%}
      {% render 'msa-content-help', page_key: 'returns' %}
    {%- when 'accessibility-statement' -%}
      {% render 'msa-content-help', page_key: 'accessibility-statement' %}
    {%- when 'privacy-policy' -%}
      {% render 'msa-content-help', page_key: 'privacy-policy' %}
    {%- when 'terms-and-conditions' -%}
      {% render 'msa-content-help', page_key: 'terms-and-conditions' %}
    {%- when 'do-not-sell-or-share' -%}
      {% render 'msa-content-help', page_key: 'do-not-sell-or-share' %}
    {%- when 'cookie-policy', 'cookie-settings' -%}
      {% render 'msa-content-help', page_key: 'cookie-policy' %}
    {%- when 'affiliate-program' -%}
      {% render 'msa-content-help', page_key: 'affiliate-program' %}
    {%- when 'lookbook' -%}
      {% render 'msa-content-simple',
        title: 'Wear your style',
        body: '<p>Explore the latest Moon Apparel collections — from everyday essentials to seasonal favourites.</p><p><a href="/collections/men-shop-all">Shop mens</a> · <a href="/collections/women-shop-all">Shop womens</a></p>'
      %}
  {%- endcase -%}
{%- elsif template.name == '404' -%}
  <div class="section sec__collection-list" style="--section-pt: 40px; --section-pb: 60px;">
    <div class="fluid_container flex justify-center align-center flex-column text-center">
      <h2 class="sec__content-heading heading-letter-spacing mt-0 mb-20" style="font-size: 3.6rem;">Oops...That link is broken.</h2>
      <p class="mb-40" style="font-size: 1.5rem;">Sorry for the inconvenience. Go to our homepage or check out our latest collections.</p>
      <a href="{{ routes.root_url }}" class="btn btn-primary">Back to homepage</a>
    </div>
  </div>
{%- endif -%}

