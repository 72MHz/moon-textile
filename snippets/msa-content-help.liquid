{% doc %}
  Full-width Moon Apparel help / policy / partner pages (Careers-style).

  @param {string} page_key - Handle key: size-charts, shipping, returns, etc.
{% enddoc %}

{% render 'msa-brand-page-styles' %}

{%- liquid
  assign hero_img = 'moon-page-store.jpg'
  assign eyebrow = 'Help'
  assign title = 'Help centre'
  assign intro = 'Clear answers and policies for shopping with Moon Apparel.'
-%}

{%- case page_key -%}
  {%- when 'size-charts' -%}
    {%- assign hero_img = 'moon-page-design.jpg' -%}
    {%- assign eyebrow = 'Fit guide' -%}
    {%- assign title = 'Size charts' -%}
    {%- assign intro = 'Find your best Moon Apparel fit. Measure yourself, compare the charts below, and check product pages for style-specific notes.' -%}
  {%- when 'shipping' -%}
    {%- assign hero_img = 'moon-page-sourcing.jpg' -%}
    {%- assign eyebrow = 'Delivery' -%}
    {%- assign title = 'Shipping' -%}
    {%- assign intro = 'How Moon Apparel processes, packs, and ships your order — at home and internationally.' -%}
  {%- when 'returns' -%}
    {%- assign hero_img = 'moon-page-office.jpg' -%}
    {%- assign eyebrow = 'Aftercare' -%}
    {%- assign title = 'Returns & exchanges' -%}
    {%- assign intro = 'Changed your mind or need a different size? Here’s how returns and exchanges work at Moon Apparel.' -%}
  {%- when 'accessibility-statement' -%}
    {%- assign hero_img = 'moon-page-team.jpg' -%}
    {%- assign eyebrow = 'Inclusion' -%}
    {%- assign title = 'Accessibility' -%}
    {%- assign intro = 'Moon Apparel is committed to making our website usable for everyone.' -%}
  {%- when 'privacy-policy' -%}
    {%- assign hero_img = 'moon-page-ethics.jpg' -%}
    {%- assign eyebrow = 'Your data' -%}
    {%- assign title = 'Privacy policy' -%}
    {%- assign intro = 'How Moon Apparel collects, uses, and protects your personal information.' -%}
  {%- when 'terms-and-conditions' -%}
    {%- assign hero_img = 'moon-page-manufacturing.jpg' -%}
    {%- assign eyebrow = 'Legal' -%}
    {%- assign title = 'Terms & conditions' -%}
    {%- assign intro = 'The rules that apply when you use the Moon Apparel website and shop with us.' -%}
  {%- when 'do-not-sell-or-share' -%}
    {%- assign hero_img = 'moon-page-ethics.jpg' -%}
    {%- assign eyebrow = 'Privacy choice' -%}
    {%- assign title = 'Do not sell or share' -%}
    {%- assign intro = 'Your privacy choices at Moon Apparel — including requests related to selling or sharing personal information.' -%}
  {%- when 'cookie-policy' -%}
    {%- assign hero_img = 'moon-page-office.jpg' -%}
    {%- assign eyebrow = 'Cookies' -%}
    {%- assign title = 'Cookie settings' -%}
    {%- assign intro = 'How Moon Apparel uses cookies, and how you can manage your preferences.' -%}
  {%- when 'affiliate-program' -%}
    {%- assign hero_img = 'moon-page-commitment.jpg' -%}
    {%- assign eyebrow = 'Partners' -%}
    {%- assign title = 'Become an affiliate' -%}
    {%- assign intro = 'Share Moon Apparel with your audience and earn commission on qualifying sales.' -%}
  {%- when 'vendors' -%}
    {%- assign hero_img = 'moon-page-sourcing.jpg' -%}
    {%- assign eyebrow = 'Partners' -%}
    {%- assign title = 'Vendor network' -%}
    {%- assign intro = 'Strategic manufacturing partnerships built on quality, reliability, and shared standards.' -%}
  {%- when 'services' -%}
    {%- assign hero_img = 'moon-page-manufacturing.jpg' -%}
    {%- assign eyebrow = 'B2B' -%}
    {%- assign title = 'Sourcing services' -%}
    {%- assign intro = 'End-to-end apparel sourcing — from vendor selection and product development to quality control and shipment coordination.' -%}
{%- endcase -%}

<div class="section moon-bp moon-help" style="--section-pt: 0; --section-pb: 0;">
  <section class="moon-bp__hero moon-help__hero">
    <div class="moon-bp__hero-media">
      <img src="{{ hero_img | asset_url }}" alt="{{ title | escape }}" loading="eager" width="1600" height="900">
      <div class="moon-bp__hero-overlay"></div>
    </div>
    <div class="moon-bp__hero-content fluid_container">
      <p class="moon-bp__eyebrow">{{ eyebrow | escape }}</p>
      <h1 class="moon-bp__hero-title">{{ title | escape }}</h1>
      <p class="moon-bp__hero-text">{{ intro | escape }}</p>
    </div>
  </section>

  {%- case page_key -%}
    {%- when 'size-charts' -%}
      <section class="moon-bp__section fluid_container">
        <div class="moon-help__grid">
          <div>
            <h2 class="moon-bp__heading">How to measure</h2>
            <div class="moon-bp__prose moon-help__prose">
              <p>Use a soft tape measure. Stand straight and keep the tape snug but not tight. Compare your measurements with the charts — if you are between sizes, we usually recommend sizing up for a more relaxed Moon Apparel fit.</p>
            </div>
          </div>
          <ul class="moon-bp__checklist moon-help__checklist">
            <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span><strong>Chest / bust</strong> — fullest part of the chest</span></li>
            <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span><strong>Waist</strong> — narrowest part of the torso</span></li>
            <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span><strong>Hips</strong> — fullest part of the hips</span></li>
            <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span><strong>Inseam</strong> — crotch to ankle along the inside leg</span></li>
          </ul>
        </div>
      </section>
      <section class="moon-bp__section moon-bp__section--soft">
        <div class="fluid_container">
          <div class="moon-help__two">
            <div>
              <h2 class="moon-bp__heading">Women’s sizes</h2>
              <div class="moon-help__table-wrap">
                <table class="moon-help__table">
                  <thead><tr><th>Size</th><th>Chest (in)</th><th>Waist (in)</th><th>Hips (in)</th></tr></thead>
                  <tbody>
                    <tr><td>XS</td><td>31–32</td><td>24–25</td><td>34–35</td></tr>
                    <tr><td>S</td><td>33–34</td><td>26–27</td><td>36–37</td></tr>
                    <tr><td>M</td><td>35–36</td><td>28–29</td><td>38–39</td></tr>
                    <tr><td>L</td><td>37–39</td><td>30–32</td><td>40–42</td></tr>
                    <tr><td>XL</td><td>40–42</td><td>33–35</td><td>43–45</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
            <div>
              <h2 class="moon-bp__heading">Men’s sizes</h2>
              <div class="moon-help__table-wrap">
                <table class="moon-help__table">
                  <thead><tr><th>Size</th><th>Chest (in)</th><th>Waist (in)</th><th>Hips (in)</th></tr></thead>
                  <tbody>
                    <tr><td>XS</td><td>32–34</td><td>26–28</td><td>32–34</td></tr>
                    <tr><td>S</td><td>35–37</td><td>29–31</td><td>35–37</td></tr>
                    <tr><td>M</td><td>38–40</td><td>32–34</td><td>38–40</td></tr>
                    <tr><td>L</td><td>41–43</td><td>35–37</td><td>41–43</td></tr>
                    <tr><td>XL</td><td>44–46</td><td>38–40</td><td>44–46</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <p class="moon-help__note">Charts are a general guide. Always check the size chart on each product page for the most accurate fit.</p>
        </div>
      </section>

    {%- when 'shipping' -%}
      <section class="moon-bp__section fluid_container">
        <div class="moon-help__cards">
          <article class="moon-help__card"><h3 class="moon-help__card-title">Processing</h3><p>Orders usually process within <strong>1–3 business days</strong> after payment clears (excluding weekends and holidays).</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Standard delivery</h3><p>Domestic standard shipping typically arrives within <strong>5–7 business days</strong> after dispatch.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">International</h3><p>International orders may take <strong>10–21 business days</strong>, depending on carrier and customs.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Tracking</h3><p>When tracking is available, we email details after your order ships. You can also check status in your account.</p></article>
        </div>
      </section>
      <section class="moon-bp__section moon-bp__section--soft">
        <div class="fluid_container moon-help__narrow">
          <h2 class="moon-bp__heading">Shipping costs &amp; customs</h2>
          <div class="moon-bp__prose moon-help__prose">
            <p>Shipping costs are calculated at checkout based on destination and order details. Promotional free-shipping offers may appear when available.</p>
            <p>For international orders, any customs duties, taxes, or import fees are the customer’s responsibility unless stated otherwise.</p>
          </div>
        </div>
      </section>

    {%- when 'returns' -%}
      <section class="moon-bp__section fluid_container">
        <div class="moon-help__cards">
          <article class="moon-help__card"><h3 class="moon-help__card-title">30-day window</h3><p>Return eligible items within <strong>30 days of delivery</strong> in unused condition with original tags attached.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">How to start</h3><p>Contact us via the <a href="/pages/contact-us">contact page</a> with your order number and the items you want to return.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Exchanges</h3><p>Where stock allows, exchange by returning the original item and ordering the correct size — or ask our team for help.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Refunds</h3><p>After we receive and inspect your return, refunds are typically processed within a few business days. Your bank may take longer to show the credit.</p></article>
        </div>
      </section>
      <section class="moon-bp__section moon-bp__section--soft">
        <div class="fluid_container moon-help__narrow">
          <h2 class="moon-bp__heading">What we can’t accept</h2>
          <div class="moon-bp__prose moon-help__prose">
            <p>Items that are worn, washed, damaged, missing tags, or marked final sale may not be eligible. Personal care or intimate items may also be excluded for hygiene reasons.</p>
          </div>
        </div>
      </section>

    {%- when 'accessibility-statement' -%}
      <section class="moon-bp__section fluid_container">
        <div class="moon-help__narrow">
          <div class="moon-bp__prose moon-help__prose">
            <p>Moon Apparel aims to provide a shopping experience that works for people of all abilities. We continually improve our website and apply relevant accessibility standards where practical.</p>
            <p>We work toward clearer navigation, readable text, keyboard-friendly controls, and meaningful image descriptions on key pages.</p>
          </div>
        </div>
        <div class="moon-help__cards moon-help__cards--3">
          <article class="moon-help__card"><h3 class="moon-help__card-title">Ongoing improvements</h3><p>We review and update templates, contrast, and interactive elements as the store evolves.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Feedback welcome</h3><p>If you find a barrier on our site, tell us — we take accessibility reports seriously.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Get help</h3><p>Need assistance placing an order? <a href="/pages/contact-us">Contact Moon Apparel</a> and our team will help.</p></article>
        </div>
      </section>

    {%- when 'privacy-policy' -%}
      <section class="moon-bp__section fluid_container">
        <div class="moon-help__two">
          <div class="moon-bp__prose moon-help__prose">
            <h2 class="moon-bp__heading">What we collect</h2>
            <p>We may collect information you provide when you create an account, place an order, join email updates, or contact us — such as name, email, shipping address, and order details.</p>
            <p>We also use cookies and similar tools to keep the site working, understand traffic, and improve shopping (see our <a href="/pages/cookie-policy">cookie settings</a> page).</p>
          </div>
          <div class="moon-bp__prose moon-help__prose">
            <h2 class="moon-bp__heading">How we use it</h2>
            <p>We use your information to process orders, provide customer service, send updates you requested, prevent fraud, and improve Moon Apparel products and website experience.</p>
            <p>We do not sell your personal data. We may share information with trusted service providers who help us operate the store (payments, shipping, email), under appropriate safeguards.</p>
          </div>
        </div>
      </section>
      <section class="moon-bp__section moon-bp__section--soft">
        <div class="fluid_container moon-help__narrow">
          <h2 class="moon-bp__heading">Your choices</h2>
          <div class="moon-bp__prose moon-help__prose">
            <p>You may request access, correction, or deletion of personal information we hold, subject to legal exceptions. See also our <a href="/pages/do-not-sell-or-share">Do not sell or share</a> page.</p>
            <p>Questions? <a href="/pages/contact-us">Contact Moon Apparel</a>.</p>
          </div>
        </div>
      </section>

    {%- when 'terms-and-conditions' -%}
      <section class="moon-bp__section fluid_container">
        <div class="moon-help__narrow">
          <div class="moon-bp__prose moon-help__prose">
            <p>By using the Moon Apparel website, you agree to these terms. If you do not agree, please do not use the site.</p>
            <h2 class="moon-bp__heading">Products &amp; pricing</h2>
            <p>All products, prices, promotions, and availability are subject to change without notice. We reserve the right to limit quantities and correct errors.</p>
            <h2 class="moon-bp__heading">Orders</h2>
            <p>Placing an order is an offer to buy. We may accept or decline orders (for example due to stock, pricing errors, or suspected fraud). You will receive confirmation when an order is accepted.</p>
            <h2 class="moon-bp__heading">Content &amp; brand</h2>
            <p>Site content, logos, and imagery are owned by Moon Apparel or our licensors and may not be copied or reused without permission.</p>
            <h2 class="moon-bp__heading">Liability</h2>
            <p>To the fullest extent permitted by law, Moon Apparel is not liable for indirect or consequential losses arising from use of the website or products, beyond the amount you paid for the relevant order.</p>
          </div>
        </div>
      </section>

    {%- when 'do-not-sell-or-share' -%}
      <section class="moon-bp__section fluid_container">
        <div class="moon-help__narrow">
          <div class="moon-bp__prose moon-help__prose">
            <p>Moon Apparel does not sell personal information for money. Depending on your region, “share” may also refer to certain advertising or analytics uses of data.</p>
            <p>If you want to opt out of sale/sharing where those laws apply, or ask about your privacy rights, contact us with the subject line <strong>Privacy request</strong>.</p>
          </div>
        </div>
        <div class="moon-help__cards moon-help__cards--3">
          <article class="moon-help__card"><h3 class="moon-help__card-title">Submit a request</h3><p>Email or message us via the <a href="/pages/contact-us">contact page</a> with your name and the email used on your account or orders.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Cookie preferences</h3><p>Manage non-essential cookies anytime via <a href="/pages/cookie-policy">cookie settings</a> or the Cookie settings control in the footer.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Full policy</h3><p>Read how we handle data in our <a href="/pages/privacy-policy">privacy policy</a>.</p></article>
        </div>
      </section>

    {%- when 'cookie-policy' -%}
      <section class="moon-bp__section fluid_container">
        <div class="moon-help__cards">
          <article class="moon-help__card"><h3 class="moon-help__card-title">Essential</h3><p>Required for security, cart, checkout, and basic site functions. These stay on so the store can work.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Preferences</h3><p>Remember choices such as region or display settings for a smoother visit.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Analytics</h3><p>Help us understand how visitors use Moon Apparel so we can improve performance and content.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Marketing</h3><p>May be used to show more relevant ads and measure campaigns across sites.</p></article>
        </div>
        <div class="moon-help__narrow" style="margin-top: 4rem; text-align: center;">
          <p class="moon-bp__lead">Update your cookie preferences anytime.</p>
          <button type="button" class="moon-bp__btn moon-bp__btn--dark" data-cookie-settings>Open cookie settings</button>
        </div>
      </section>

    {%- when 'affiliate-program' -%}
      <section class="moon-bp__section fluid_container">
        <div class="moon-help__two">
          <div class="moon-bp__prose moon-help__prose">
            <h2 class="moon-bp__heading">Partner with Moon Apparel</h2>
            <p>If you create content, run a community, or love sharing style finds, our affiliate program lets you earn commission when your audience shops Moon Apparel through your link.</p>
            <p>Tell us about your platform, audience size, and content style — we’ll follow up with next steps.</p>
          </div>
          <ul class="moon-bp__checklist moon-help__checklist">
            <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span>Unique tracking links</span></li>
            <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span>Commission on qualifying sales</span></li>
            <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span>Access to seasonal drops &amp; favourites</span></li>
            <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span>Support from the Moon Apparel team</span></li>
          </ul>
        </div>
      </section>

    {%- when 'vendors' -%}
      <section class="moon-bp__section fluid_container">
        <div class="moon-help__narrow">
          <div class="moon-bp__prose moon-help__prose">
            <p>Our technical expertise and industry experience help us identify and engage the right partners for each project — so client requirements for quality, timing, and compliance are met with precision.</p>
            <p>From quick-turn orders to value-added production across fabrics, styles, and trims, our vendor network is built for reliability.</p>
          </div>
        </div>
        <div class="moon-help__cards moon-help__cards--3">
          <article class="moon-help__card"><h3 class="moon-help__card-title">Vendor evaluation</h3><p>We prioritise evaluation, selection, and training — building relationships based on trust and performance.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Backup capacity</h3><p>Second-line vendors stay ready for running items so supply stays uninterrupted.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Quality first</h3><p>Partners must meet quality and delivery requirements before taking an order — and we help promising vendors reach global standards.</p></article>
        </div>
      </section>
      <section class="moon-bp__section moon-bp__section--soft">
        <div class="fluid_container">
          <div class="moon-bp__section-head">
            <h2 class="moon-bp__heading">Certifications we look for</h2>
          </div>
          <ul class="moon-help__certs">
            <li>Global Recycled Standard</li><li>Sedex</li><li>BSCI</li><li>C-TPAT</li><li>GOTS</li><li>ISO</li><li>WRAP</li><li>OEKO-TEX</li><li>BCI</li>
          </ul>
        </div>
      </section>

    {%- when 'services' -%}
      <section class="moon-bp__section fluid_container">
        <div class="moon-help__narrow">
          <div class="moon-bp__prose moon-help__prose">
            <p>Moon Apparel’s sourcing arm delivers complete apparel solutions — vendor identification, product development, quality control, packaging, and shipment coordination — aligned to international standards and buyer expectations.</p>
          </div>
        </div>
        <div class="moon-help__cards">
          <article class="moon-help__card"><h3 class="moon-help__card-title">Sourcing</h3><p>Supplier options matched to merchandise needs — quality, price, and shipment capability.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Production monitoring</h3><p>Daily merchandising oversight so product aesthetics and timing stay on track.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Quality assurance</h3><p>Inline and final inspections against buyer specs and international standards.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Product development</h3><p>Prototypes, pattern checks, production samples, and fabric development support.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Labeling &amp; packing</h3><p>Strict adherence to labeling, packing, and carton marking instructions.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Shipping coordination</h3><p>Document checks and dispatch coordination per buyer and L/C instructions.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Labor practices</h3><p>Partners expected to uphold safe, fair labour standards — no child, prison, or forced labour.</p></article>
          <article class="moon-help__card"><h3 class="moon-help__card-title">Fabric sourcing</h3><p>Trusted mills for materials that meet quality, sustainability, and compliance goals.</p></article>
        </div>
      </section>
  {%- endcase -%}

  <section class="moon-bp__cta">
    <div class="fluid_container moon-bp__cta-inner">
      <h2 class="moon-bp__heading moon-bp__heading--light">Need more help?</h2>
      <p class="moon-bp__lead moon-bp__lead--light">Our team is here for orders, fit, returns, partnerships, and privacy questions.</p>
      <a href="/pages/contact-us" class="moon-bp__btn moon-bp__btn--light">Contact Moon Apparel</a>
    </div>
  </section>
</div>

{% stylesheet %}
  .moon-help__hero { min-height: clamp(34rem, 52vh, 48rem); }
  .moon-help__narrow { max-width: 78rem; margin-left: auto; margin-right: auto; }
  .moon-help__prose { margin: 0; max-width: none; }
  .moon-help__prose .moon-bp__heading { margin-top: 2.4rem; }
  .moon-help__prose .moon-bp__heading:first-child { margin-top: 0; }
  .moon-help__grid,
  .moon-help__two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .moon-help__checklist { margin-top: 0; max-width: none; }
  .moon-help__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem 2rem;
  }
  .moon-help__cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .moon-help__card {
    padding: 2.4rem;
    background: #fff;
    border: 1px solid #e6ebf2;
    border-top: 3px solid #e85d04;
  }
  .moon-help__card-title {
    margin: 0 0 1rem;
    font-size: 1.8rem;
    color: #1a3a6b;
  }
  .moon-help__card p { margin: 0; font-size: 1.45rem; line-height: 1.65; color: #444; }
  .moon-help__card a { color: #e85d04; font-weight: 700; }
  .moon-help__table-wrap { overflow-x: auto; }
  .moon-help__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.4rem;
  }
  .moon-help__table th,
  .moon-help__table td {
    padding: 1.2rem 1.4rem;
    text-align: left;
    border-bottom: 1px solid #e6ebf2;
  }
  .moon-help__table th {
    background: #1a3a6b;
    color: #fff;
    font-weight: 700;
  }
  .moon-help__table tr:nth-child(even) td { background: #f8f9fb; }
  .moon-help__note {
    margin: 2.4rem 0 0;
    font-size: 1.4rem;
    color: #666;
    text-align: center;
  }
  .moon-help__certs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
