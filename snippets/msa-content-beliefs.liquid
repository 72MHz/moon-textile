{% doc %}
  Our beliefs hub page for Moon Apparel.
{% enddoc %}

{% render 'msa-brand-page-styles' %}

<div class="section moon-bp" style="--section-pt: 0; --section-pb: 0;">
  <section class="moon-bp__hero">
    <div class="moon-bp__hero-media">
      <img
        src="{{ 'moon-page-beliefs.jpg' | asset_url }}"
        alt="Moon Apparel community and brand values"
        loading="eager"
        width="1600"
        height="900"
      >
      <div class="moon-bp__hero-overlay"></div>
    </div>
    <div class="moon-bp__hero-content fluid_container">
      <p class="moon-bp__eyebrow">Our beliefs</p>
      <h1 class="moon-bp__hero-title">What Moon Apparel stands for</h1>
      <p class="moon-bp__hero-text">
        About us tells our story. Our beliefs explain our principles — quality craftsmanship,
        ethical manufacturing, fair labour, responsible sourcing, and giving back through education.
      </p>
    </div>
  </section>

  <section class="moon-bp__section fluid_container">
    <div class="moon-bp__section-head">
      <h2 class="moon-bp__heading">Our principles</h2>
      <p class="moon-bp__lead">
        We believe fashion should be accessible, responsibly made, and designed to inspire confidence
        in every customer — without compromising quality or character.
      </p>
    </div>
    <ul class="moon-bp__checklist">
      <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span>Quality craftsmanship in every garment</span></li>
      <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span>Ethical manufacturing partnerships</span></li>
      <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span>Fair labour and safe working conditions</span></li>
      <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span>Responsible sourcing of materials</span></li>
      <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span>Less waste across production and packaging</span></li>
      <li class="moon-bp__check-item"><span class="moon-bp__check-icon" aria-hidden="true"></span><span>Giving back through education with SAVE DC</span></li>
    </ul>
  </section>

  <section class="moon-bp__section moon-bp__section--soft">
    <div class="fluid_container">
      <div class="moon-bp__section-head">
        <h2 class="moon-bp__heading">Explore our commitments</h2>
        <p class="moon-bp__lead">Dive deeper into the values that guide Moon Apparel every day.</p>
      </div>
      <div class="moon-bp__cards">
        <a class="moon-bp__card" href="/pages/commitment">
          <span class="moon-bp__card-label">Community</span>
          <h3 class="moon-bp__card-title">Commitment</h3>
          <p class="moon-bp__card-text">Our charitable partner SAVE DC and impact beyond fashion.</p>
          <span class="moon-bp__card-cta">Learn more</span>
        </a>
        <a class="moon-bp__card" href="/pages/ethics">
          <span class="moon-bp__card-label">Standards</span>
          <h3 class="moon-bp__card-title">Ethics</h3>
          <p class="moon-bp__card-text">Respect, fairness, and integrity in every decision.</p>
          <span class="moon-bp__card-cta">Learn more</span>
        </a>
        <a class="moon-bp__card" href="/pages/organic-cotton">
          <span class="moon-bp__card-label">Materials</span>
          <h3 class="moon-bp__card-title">Organic cotton</h3>
          <p class="moon-bp__card-text">Softer fabrics grown with healthier farming practices.</p>
          <span class="moon-bp__card-cta">Learn more</span>
        </a>
        <a class="moon-bp__card" href="/pages/recycled-polyester">
          <span class="moon-bp__card-label">Materials</span>
          <h3 class="moon-bp__card-title">Recycled polyester</h3>
          <p class="moon-bp__card-text">Giving existing materials a second life.</p>
          <span class="moon-bp__card-cta">Learn more</span>
        </a>
        <a class="moon-bp__card" href="/pages/responsible-sourcing">
          <span class="moon-bp__card-label">Supply</span>
          <h3 class="moon-bp__card-title">Responsible sourcing</h3>
          <p class="moon-bp__card-text">Partners who share our ethical production standards.</p>
          <span class="moon-bp__card-cta">Learn more</span>
        </a>
        <a class="moon-bp__card" href="/pages/less-waste">
          <span class="moon-bp__card-label">Planet</span>
          <h3 class="moon-bp__card-title">Less waste</h3>
          <p class="moon-bp__card-text">Smarter production and packaging choices.</p>
          <span class="moon-bp__card-cta">Learn more</span>
        </a>
      </div>
    </div>
  </section>

  <section class="moon-bp__cta">
    <div class="fluid_container moon-bp__cta-inner">
      <h2 class="moon-bp__heading moon-bp__heading--light">Want to know more about Moon Apparel?</h2>
      <p class="moon-bp__lead moon-bp__lead--light">
        Read our story, explore careers, or get in touch with the team.
      </p>
      <a href="/pages/about" class="moon-bp__btn moon-bp__btn--light">About Moon Apparel</a>
    </div>
  </section>
</div>
