{% doc %}
  Renders the Moon Style Apparel hero banner: a single desktop image and a
  single mobile image, swapped by breakpoint.

  @param {string} heading - Hero heading for alt text
  @param {string} [class] - CSS class for the img elements
{% enddoc %}

<div class="unionbay-hero__split absolute inset-0 w-full h-full">
  <img
    src="{{ 'ub-hero-desktop.jpg' | asset_url }}"
    alt="{{ heading | escape }}"
    class="unionbay-hero__asset unionbay-hero__asset--desktop"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    width="1400"
    height="1745"
  >
  <img
    src="{{ 'ub-hero-mobile.jpg' | asset_url }}"
    alt="{{ heading | escape }}"
    class="unionbay-hero__asset unionbay-hero__asset--mobile"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    width="900"
    height="1118"
  >
</div>
