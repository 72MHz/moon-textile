{% doc %}
  Union Bay footer newsletter column with email signup, consent checkbox, social icons, and payment methods.

  @param {object} block - Newsletter block object
  @param {object} section - Parent section object
  @param {boolean} show_social - Whether to show social icons
  @param {boolean} payment_enable - Whether to show payment icons
{% enddoc %}

{%- liquid
  assign block_st = block.settings
  assign email_id = 'UnionbayNewsletter-' | append: section.id | append: '-' | append: block.id
  assign checkbox_id = 'UnionbayNewsletterConsent-' | append: section.id | append: '-' | append: block.id
-%}

<div class="unionbay-footer-newsletter">
  {%- if block_st.heading != blank -%}
    <h3 class="unionbay-footer-newsletter__heading">{{ block_st.heading | escape }}</h3>
  {%- endif -%}

  {%- if block_st.description != blank -%}
    <p class="unionbay-footer-newsletter__description">{{ block_st.description }}</p>
  {%- endif -%}

  {%- form 'customer', id: 'ContactUnionbayFooter', class: 'unionbay-footer-newsletter__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">

    <div class="unionbay-footer-newsletter__field">
      <input
        type="email"
        id="{{ email_id }}"
        name="contact[email]"
        class="unionbay-footer-newsletter__input"
        value="{{ form.email }}"
        autocomplete="email"
        autocapitalize="off"
        placeholder=" "
        required
        {% if form.errors %}
          aria-invalid="true"
          aria-describedby="ContactUnionbayFooter-error"
        {% elsif form.posted_successfully? %}
          aria-describedby="ContactUnionbayFooter-success"
        {% endif %}
      >
      <label for="{{ email_id }}" class="unionbay-footer-newsletter__label">
        {%- if block_st.email_placeholder != blank -%}
          {{ block_st.email_placeholder }}
        {%- else -%}
          {{ 'newsletter.label' | t }}
        {%- endif -%}
      </label>
      <button
        type="submit"
        class="unionbay-footer-newsletter__submit"
        name="commit"
        aria-label="{%- if block_st.button_label != blank -%}{{ block_st.button_label }}{%- else -%}{{ 'newsletter.button_label' | t }}{%- endif -%}"
      >
        {%- if block_st.button_label != blank -%}
          {{ block_st.button_label }}
        {%- else -%}
          {{ 'newsletter.button_label' | t }}
        {%- endif -%}
      </button>
    </div>

    {%- if block_st.note != blank -%}
      <div class="unionbay-footer-newsletter__consent">
        <input
          type="checkbox"
          id="{{ checkbox_id }}"
          class="unionbay-footer-newsletter__checkbox"
          required
        >
        <label for="{{ checkbox_id }}" class="unionbay-footer-newsletter__consent-label">
          {{ block_st.note }}
        </label>
      </div>
    {%- endif -%}

    {%- if form.errors -%}
      <div class="unionbay-footer-newsletter__message unionbay-footer-newsletter__message--error" id="ContactUnionbayFooter-error">
        {%- render 'icon-error' -%}
        {{- form.errors.translated_fields.email | capitalize }}
        {{ form.errors.messages.email -}}
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? -%}
      <div class="unionbay-footer-newsletter__message unionbay-footer-newsletter__message--success" id="ContactUnionbayFooter-success">
        {%- render 'icon-success' -%}
        <span>{{ 'newsletter.success' | t }}</span>
      </div>
    {%- endif -%}
  {%- endform -%}

  {%- if show_social or payment_enable -%}
    <div class="unionbay-footer-newsletter__extras">
      {%- if show_social -%}
        <div class="unionbay-footer-newsletter__social">
          {% render 'unionbay-footer-social' %}
        </div>
      {%- endif -%}

      {%- if payment_enable and shop.enabled_payment_types != empty -%}
        <div class="unionbay-footer-newsletter__payment">
          <ul class="list-unstyled unionbay-footer-newsletter__payment-list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color unionbay-footer-newsletter__payment-icon' }}</li>
            {%- endfor -%}
            {%- comment -%} Extra accepted methods not in Shopify's auto icon set {%- endcomment -%}
            <li><svg class="icon icon--full-color unionbay-footer-newsletter__payment-icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" width="38" height="24" role="img" aria-labelledby="pi-stripe"><title id="pi-stripe">Stripe</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"></path><path fill="#635bff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"></path><text x="19" y="15.5" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="8" font-weight="700" fill="#fff">stripe</text></svg></li>
            <li><svg class="icon icon--full-color unionbay-footer-newsletter__payment-icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" width="38" height="24" role="img" aria-labelledby="pi-worldpay"><title id="pi-worldpay">Worldpay</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"></path><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"></path><text x="19" y="15" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="5.6" font-weight="700" fill="#d0021b">worldpay</text></svg></li>
            <li><svg class="icon icon--full-color unionbay-footer-newsletter__payment-icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" width="38" height="24" role="img" aria-labelledby="pi-square"><title id="pi-square">Square</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"></path><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"></path><text x="19" y="15.5" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="7" font-weight="700" fill="#1b1b1b">square</text></svg></li>
            <li><svg class="icon icon--full-color unionbay-footer-newsletter__payment-icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" width="38" height="24" role="img" aria-labelledby="pi-gocardless"><title id="pi-gocardless">GoCardless</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"></path><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"></path><text x="19" y="15" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="4.4" font-weight="700" fill="#1e2b3c">GoCardless</text></svg></li>
          </ul>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
